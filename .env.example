# TinderForDinner Environment Configuration
# Copy this file as .env and fill in your values

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth Configuration
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id_here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your_google_expo_client_id_here

# Debug Mode (optional)
EXPO_PUBLIC_DEBUG_MODE=true

# Google OAuth Configuration
GOOGLE_EXPO_CLIENT_ID=your-expo-google-client-id
GOOGLE_IOS_CLIENT_ID=your-ios-google-client-id
GOOGLE_ANDROID_CLIENT_ID=your-android-google-client-id
GOOGLE_WEB_CLIENT_ID=your-web-google-client-id

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# App Configuration
EXPO_PUBLIC_SCHEME=com.yourcompany.tinderfordinner